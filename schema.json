{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Controls System Archiver json interface schema",
    "type": "object",
    "properties": {
        "meta": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string"
                },
                "data_type": {
                    "type": "string"
                }
            },
            "required": [
                "name",
                "data_type"
            ]
        },
        "data": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "secs": {
                        "type": "integer",
                        "description": "seconds since epoch UTC"
                    },
                    "nanos": {
                        "type": "integer"
                    },
                    "val": {
                        "type": "data_type"
                    },
                    "meta": {
                        "type": "object",
                        "properties": {
                            "status": {
                                "type": "string"
                            },
                            "EPICSmeta": {
                                "type": "EPICSArchiverMeta"
                            },
                            "TangoMeta": {
                                "type": "TangoArchiverMeta"
                            }
                        }
                    }
                },
                "required": [
                    "secs",
                    "nanos",
                    "val"
                ]
            }
        }
    },
    "required": [
        "meta",
        "data"
    ]
}