{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Controls System Archiver json interface schema",
    "type": "object",
    "properties": {
        "meta": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string"
                },
                "data_type": {
                    "type": "string",
                    "enum": ["str", "bool", "u8", "u16", "u32", "u64", "i8", "i16", "i32", "i64", "f32", "f64", "state", "enum", "blob"]
                }
            },
            "required": [
                "name",
                "data_type"
            ]
        },
        "data": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "secs": {
                        "type": "integer",
                        "description": "seconds since epoch UTC"
                    },
                    "nanos": {
                        "type": "integer"
                    },
                    "val": {
                        "anyOf": [
                        {
                        "type": "string"
                        },
                        {
                        "type": "number"
                        },
                        {
                        "type": "boolean"
                        },
                        {
                        "type": "integer"
                        }
                        ]
                    },
                    "meta": {
                        "type": "object",
                        "properties": {
                            "status": {
                                "type": "string"
                            },
                            "EPICSmeta": {
                                "type": "object"
                            },
                            "TangoMeta": {
                                "type": "object"
                            }
                        }
                    }
                },
                "required": [
                    "secs",
                    "nanos",
                    "val"
                ]
            }
        }
    },
    "required": [
        "meta",
        "data"
    ],
    "allOf": [
        {
            "if": {
                "properties": {
                    "meta": {
                        "properties": {
                            "data_type": {"const": "str"}
                        }
                    }
                }
            },
            "then": {
                "properties": {
                    "data": {
                        "items":{
                            "properties": {
                                "val": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "meta": {
                        "properties": {
                            "data_type": {"const": "bool"}
                        }
                    }
                }
            },
            "then": {
                "properties": {
                    "data": {
                        "items":{
                            "properties": {
                                "val": {
                                    "type": "boolean"
                                }
                            }
                        }
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "meta": {
                        "properties": {
                            "data_type": {"enum": ["f32", "f64"]}
                        }
                    }
                }
            },
            "then": {
                "properties": {
                    "data": {
                        "items":{
                            "properties": {
                                "val": {
                                    "type": "number"
                                }
                            }
                        }
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "meta": {
                        "properties": {
                            "data_type": {"enum": ["u8", "u16", "u32", "u64", "i8", "i16", "i32", "i64"]}
                        }
                    }
                }
            },
            "then": {
                "properties": {
                    "data": {
                        "items":{
                            "properties": {
                                "val": {
                                    "type": "integer"
                                }
                            }
                        }
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "meta": {
                        "properties": {
                            "data_type": {"enum": ["enum", "state"]}
                        }
                    }
                }
            },
            "then": {
                "properties": {
                    "data": {
                        "items":{
                            "properties": {
                                "val": {
                                    "type": "integer"
                                }
                            }
                        }
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "meta": {
                        "properties": {
                            "data_type": {"const": "blob"}
                        }
                    }
                }
            },
            "then": {
                "properties": {
                    "data": {
                        "items":{
                            "properties": {
                                "val": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        }
    ]
}
