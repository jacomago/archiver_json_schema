{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Controls System Archiver json interface schema",
    "type": "object",
    "properties": {
        "meta": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string"
                },
                "waveform": {
                    "type": "boolean"
                }
            },
            "required": [
                "name",
                "waveform"
            ]
        },
        "data": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "secs": {
                        "type": "integer"
                    },
                    "nanos": {
                        "type": "integer"
                    },
                    "val": {
                        "type": [
                            "integer",
                            "number",
                            "array",
                            "object",
                            "string",
                            "boolean"
                        ]
                    }
                },
                "required": [
                    "secs",
                    "nanos",
                    "val"
                ]
            }
        }
    },
    "required": [
        "meta",
        "data"
    ]
}